{
  "name": "@remotedeck/desktop",
  "version": "1.0.1",
  "private": true,
  "description": "A secure Windows SSH workspace for Linux remote-development workflows",
  "author": "RemoteDeck contributors",
  "license": "MIT",
  "homepage": "https://github.com/shilittle/RemoteDeck",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:openssh": "vitest run --config vitest.openssh.config.ts",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "test:e2e": "pnpm ensure:electron && pnpm build && playwright test",
    "build": "electron-vite build",
    "generate:assets": "node scripts/generate-icons.mjs",
    "dist:win": "pnpm ensure:electron && pnpm generate:assets && pnpm build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "echarts": "6.1.0",
    "lucide-react": "1.26.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ssh2": "1.17.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
